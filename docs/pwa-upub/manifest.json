{
  "name": "uPub",
  "short_name": "uPub",
  "description": "Offline document editor with built-in version history",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#1e1e2e",
  "theme_color": "#181825",
  "orientation": "any",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "productivity",
    "utilities"
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/html": [
          ".html"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
